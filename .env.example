API_BASE_URL=https://lastochki.store/api/v1
DEFAULT_STORE_ID=2
# Canonical origin only, without /shop (basePath is fixed at build time)
PUBLIC_ORIGIN=http://localhost:3000
# Optional second storefront origin; no path, no wildcard.
SECONDARY_PUBLIC_ORIGIN=
# Domain registered in merchant YooKassa; callbacks use /shop/payment and /shop/cards
ALLOWED_PAYMENT_RETURN_URL=https://lastochki.store
SESSION_DB_PATH=.data/sessions.sqlite
# Production: 64 random hex characters. Never commit the real value.
SESSION_ENCRYPTION_KEY=
# Set to true once the payment return domain is verified in YooKassa merchant dashboard
CHECKOUT_ENABLED=false

